@host = https://localhost:7000

### Test without authentication
GET {{host}}/api/auth-test
Accept: application/json

### Test with Keycloak authentication
GET {{host}}/api/auth-test
Authorization: Bearer {{$auth.token("keycloak")}}
Accept: application/json

### Get active recipients
GET {{host}}/api/v1/recipients
Authorization: Bearer {{$auth.token("keycloak")}}
Accept: application/json

### Get all recipients, including archived
GET {{host}}/api/v1/recipients?includeArchived=true
Authorization: Bearer {{$auth.token("keycloak")}}
Accept: application/json

### Get recipients without authentication
GET {{host}}/api/v1/recipients
Accept: application/json

### Get recipient by ID
GET {{host}}/api/v1/recipients/ff14d147-cbc1-4205-15bd-08df2f8d50ed
Authorization: Bearer {{$auth.token("keycloak")}}
Accept: application/json

### Create recipient
POST {{host}}/api/v1/recipients
Authorization: Bearer {{$auth.token("keycloak")}}
Content-Type: application/json
Accept: application/json

{
    "name": "   Dad ",
    "description": "Christmas and birthday gifts",
    "birthDate": "1970-05-15",
    "relationship": "ImmediateFamily"
}
